# Copy this file to .env and fill it in.  NEVER commit .env to Git.

# Name shown on the website, alerts and /help
BOT_NAME=Ursa-kingshot

# --- Discord bot (Developer Portal -> your app -> Bot) ---
DISCORD_TOKEN=
# Your Discord user ID(s), comma separated: full control of every server + gift codes
OWNER_IDS=
# Optional: only allow these server IDs (comma separated). The bot leaves any other server.
ALLOWED_GUILD_IDS=
# true = members can /add their own Kingshot accounts
ALLOW_PUBLIC_ADD=true

# --- Website login with Discord (Developer Portal -> your app -> OAuth2) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# The address people use to open the website (no slash at the end).
# On your Mac: http://localhost:8080   On Azure: https://<your-label>.uksouth.cloudapp.azure.com
PUBLIC_URL=http://localhost:8080
# Only on Azure: the domain name for the HTTPS certificate (PUBLIC_URL without https://)
DOMAIN=

# --- Kingshot gift-code website ---
KS_API_BASE=https://kingshot-giftcode.centurygame.com/api
KS_SALT=
REQUEST_DELAY=3
MAX_CONSECUTIVE_ERRORS=5

# --- Automatic code discovery ---
CODES_FEED_URL=https://kingshot.net/api/gift-codes
CHECK_INTERVAL_MIN=60
AUTO_REDEEM=true

# Port on your computer for the website (8081 if Jenkins uses 8080)
WEB_HOST_PORT=8080
WEB_PORT=8080
DB_PATH=data/kingshot.db
